# Datenbank
POSTGRES_USER=bestellung
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=bestellung

# Session-Secret erzeugen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-in-production

# Auf dem Server hinter einem TLS-Reverse-Proxy (HTTPS) auf true setzen
SESSION_COOKIE_SECURE=false

# Host-Port der App. Lokal 8000, auf dem Server 127.0.0.1:8001
# (dann nur fuer den Reverse-Proxy erreichbar)
APP_BIND=8000

# Haupt-Admin (wird nur beim allerersten Start angelegt)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# Domains. Leer lassen = alles laeuft ueber die Domain, mit der aufgerufen wird.
# ADMIN_BASE_URL: Verwaltung + Kuechenmonitor (Login erforderlich)
# GUEST_BASE_URL: Gaeste-Domain, auf die QR-Code/Link zeigen. Auf dieser Domain
#                 sind nur die Gaeste-Seiten erreichbar. Gleiche Domain wie
#                 ADMIN_BASE_URL = alles laeuft ueber eine Domain.
# Auf dem Server z.B.: https://bestellung.example.com
ADMIN_BASE_URL=
GUEST_BASE_URL=

# Absender-Kennung fuer Push-Benachrichtigungen (leer = mailto:ADMIN_EMAIL)
VAPID_SUBJECT=

# Optional: Anmeldung ueber authentik (OpenID Connect) zusaetzlich zum Passwort.
# In authentik einen "OAuth2/OpenID Provider" (confidential) anlegen,
# Redirect-URI: <ADMIN_BASE_URL>/login/oidc/callback
# OIDC_ISSUER = "OpenID Configuration Issuer" aus authentik, z.B.
#   https://auth.example.com/application/o/bestell-manager/
# Leer lassen = Button wird nicht angezeigt.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_BUTTON_LABEL=Mit authentik anmelden

# Zeitzone fuer "heute" (Gueltigkeit der Bestell-Links)
TIMEZONE=Europe/Vienna
