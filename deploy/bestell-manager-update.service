[Unit]
Description=Bestell-Manager: auf neue Version pruefen und aktualisieren
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/bestell_manager
ExecStart=/bin/sh /srv/bestell_manager/scripts/auto-update.sh
# Ein Image-Build kann dauern
TimeoutStartSec=15min
